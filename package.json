{
  "name": "genderapi",
  "version": "2.0.0",
  "description": "Official GenderAPI.io V2 client for JavaScript and TypeScript",
  "keywords": [
    "genderapi",
    "gender",
    "name",
    "email",
    "username",
    "api-client"
  ],
  "homepage": "https://www.genderapi.io/api-documentation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenderAPI/genderapi-js.git"
  },
  "bugs": {
    "url": "https://github.com/GenderAPI/genderapi-js/issues"
  },
  "author": "GenderAPI.io",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run build && node --test test/client.test.mjs test/no-network.test.mjs test/cjs.test.cjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
